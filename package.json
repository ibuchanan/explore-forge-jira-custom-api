{
  "name": "explore-forge-jira-custom-api",
  "version": "0.0.0",
  "private": true,
  "description": "Exploration Forge App for a Jira custom REST API",
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": "24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "changelog": "turbo run changelog",
    "check": "turbo run check",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "forge:deploy": "turbo run forge:deploy --filter=forge-app",
    "forge:install": "turbo run forge:install --filter=forge-app",
    "forge:uninstall": "turbo run forge:uninstall --filter=forge-app",
    "forge:upgrade": "turbo run forge:upgrade --filter=forge-app",
    "forge:scopes": "turbo run forge:scopes --filter=forge-app",
    "generate": "turbo run generate",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:api:bootstrap": "uv run integration/bootstrap-oauth.py",
    "test:api": "hurl --version >/dev/null || (echo 'Error: Hurl is not installed. Visit https://hurl.dev to install.' && exit 1); test -f integration/.oauth.hurl || (echo 'Error: integration/.oauth.hurl is missing. Run npm run test:api:bootstrap first.' && exit 1); hurl --test --variables-file integration/.env.hurl --variables-file integration/.oauth.hurl integration/workitem.hurl",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "turbo": "^2.9.14",
    "typescript": "^5"
  }
}
