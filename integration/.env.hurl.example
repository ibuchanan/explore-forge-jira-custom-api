# Copy this file to integration/.env.hurl and fill in your values.
# integration/.env.hurl is git-ignored — never commit real OAuth secrets.
#
# Used by: npm run test:api
# Hurl variables docs: https://hurl.dev/docs/manual.html#variables
# Atlassian OAuth refresh tokens: https://developer.atlassian.com/cloud/oauth/getting-started/refresh-tokens/
#
# URL format:
#   https://<site>.atlassian.net/gateway/api/svc/jira/apps/<app-id>_<env-id>
#
# - app-id:  from apps/forge/manifest.yml app.id (strip the ari:cloud:ecosystem::app/ prefix)
# - env-id:  from `forge environments list` (UUID for the target environment)

# ---------------------------------------------------------------------------
# OAuth refresh-token flow
# ---------------------------------------------------------------------------

# OAuth 2.0 (3LO) client credentials from the Atlassian Developer Console.
oauth_client_id=<your-oauth-client-id>
oauth_client_secret=<your-oauth-client-secret>

# 3LO OAuth refresh token. The Hurl suite exchanges this for a fresh access
# token before running App REST API requests.
#
# Required custom scopes on the grant:
#   write:workitem:custom          — for /workitem and /workitem/upsert
#   write:workitem-as-user:custom  — for /workitem/asuser and /workitem/upsert/asuser
#
# Atlassian refresh tokens rotate. The test captures the new token as
# `new_refresh_token`; update this value after a successful run if needed.
oauth_refresh_token=<your-3lo-refresh-token>

# ---------------------------------------------------------------------------
# Required for all workitem endpoints
# ---------------------------------------------------------------------------

# Base URL for this app's Forge App REST API.
base_url=https://your-site.atlassian.net/gateway/api/svc/jira/apps/bb398628-d837-4378-9fe5-9b033fb24aac_<env-id>

# Jira project key (e.g. HSP). Token holder must have Create Issue permission here.
project=HSP

# Issue type name valid in the project above (e.g. Story, Bug, Task).
issue_type=Story

# ---------------------------------------------------------------------------
# Required for /workitem/asuser and /workitem/upsert/asuser only
# ---------------------------------------------------------------------------

# Jira accountId of the user to raise issues on behalf of.
# You can get this from the Forge admin page's Account ID lookup section.
raise_on_behalf_of=557057:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Required for upsert happy-path tests — must be unique per run to avoid
# dedup collisions. Use a timestamp or UUID.
# ---------------------------------------------------------------------------
uuid=replace-with-unique-value
