# Copy this file to integration/.env.hurl and fill in your values.
# .env.hurl is git-ignored — never commit real tokens.
#
# URL format:
#   https://<site>.atlassian.net/gateway/api/svc/jira/apps/<app-id>_<env-id>
#
# - app-id:  from the manifest app.id field (strip the ari:cloud:ecosystem::app/ prefix)
# - env-id:  from Developer Console > Environments (the UUID for the environment)
# - token:   3LO OAuth 2.0 bearer token with write:workitem:custom scope
base_url=https://your-site.atlassian.net/gateway/api/svc/jira/apps/bb398628-d837-4378-9fe5-9b033fb24aac_<env-id>
token=<your-3lo-bearer-token>
project=HSP
issue_type=Story
