# Copy this file to integration/.env.hurl and fill in your values.
# integration/.env.hurl is git-ignored — never commit real OAuth secrets.
#
# Used by: npm run test:api:api-route
# Hurl variables docs: https://hurl.dev/docs/manual.html#variables
# Atlassian OAuth 2.0 (3LO): https://developer.atlassian.com/cloud/oauth/getting-started/implementing-oauth-3lo/
#
# URL format:
#   https://<site>.atlassian.net/gateway/api/svc/jira/apps/<app-id>_<env-id>
#
# - app-id:  from apps/api-route/manifest.yml app.id (strip the ari:cloud:ecosystem::app/ prefix)
# - env-id:  from `forge environments list` (UUID for the target environment)

# ---------------------------------------------------------------------------
# OAuth access-token bootstrap flow
# ---------------------------------------------------------------------------

# OAuth 2.0 (3LO) client credentials from the Atlassian Developer Console.
# Used by Hurl directly and by `npm run test:api:api-route:bootstrap`.
#
# The Python bootstrap script requires this OAuth callback URL in the Developer Console:
#   http://localhost:9876/callback
oauth_client_id=<your-oauth-client-id>
oauth_client_secret=<your-oauth-client-secret>

# Space-separated scopes requested by `npm run test:api:api-route:bootstrap`.
# This mirrors the Atlassian Developer Console generated authorization URL.
# App API custom scopes are mutually exclusive with offline_access in the
# Developer Console, so the bootstrap script hands Hurl an access token directly.
oauth_scopes=write:workitem:custom write:workitem-as-user:custom

# `npm run test:api:api-route:bootstrap` writes the generated access and refresh
# tokens to integration/api-route/.oauth.hurl. Hurl loads that generated file
# alongside this stable configuration file during `npm run test:api:api-route`.
# The workitem.hurl suite uses the refresh token to obtain a fresh access token
# automatically at the start of each run — no re-bootstrap needed until the
# refresh token itself expires (90 days).
#
# The bootstrap script derives Atlassian's `sns` authorization parameter from
# base_url. If needed, override it explicitly with:
# oauth_sns=<app-id>.<env-id>

# ---------------------------------------------------------------------------
# Required for all workitem endpoints
# ---------------------------------------------------------------------------

# Base URL for this app's Forge App REST API.
base_url=https://your-site.atlassian.net/gateway/api/svc/jira/apps/bb398628-d837-4378-9fe5-9b033fb24aac_<env-id>

# Jira project key (e.g. MOBL). Token holder must have Create Issue permission here.
project=MOBL

# Issue type name valid in the project above (e.g. Story, Bug, Task).
issue_type=Story

# ---------------------------------------------------------------------------
# Required for /workitem/asuser and /workitem/upsert/asuser only
# ---------------------------------------------------------------------------

# Jira accountId of the user to raise issues on behalf of.
# You can get this from the Forge admin page's Account ID lookup section.
raise_on_behalf_of=557057:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
