# Copy this file to integration/webtrigger/.env.hurl and fill in your values.
# integration/webtrigger/.env.hurl is git-ignored — never commit real secrets.
#
# Used by: npm run test:api:webtrigger
# Hurl variables docs: https://hurl.dev/docs/manual.html#variables
#
# Webtrigger URLs are generated per-installation. After deploying and installing
# the app, retrieve them with:
#
#   forge webtrigger list
#
# Each trigger has its own URL. Use the URL for each trigger key below.

# ---------------------------------------------------------------------------
# JWT bootstrap
# ---------------------------------------------------------------------------

# Shared secret for plain (non-as-user) endpoints.
# Must match the value set with:
#   forge variables set --environment development WEBTRIGGER_TOKEN <value>
webtrigger_token=<your-webtrigger-token>

# Shared secret for as-user endpoints.
# Must match the value set with:
#   forge variables set --environment development WEBTRIGGER_AS_USER_TOKEN <value>
webtrigger_as_user_token=<your-webtrigger-as-user-token>

# `npm run test:api:webtrigger:bootstrap` mints short-lived JWTs from these
# secrets and writes them to integration/webtrigger/.jwt.hurl. Hurl loads
# that generated file alongside this stable configuration file.

# ---------------------------------------------------------------------------
# Webtrigger URLs (from `forge webtrigger list`)
# ---------------------------------------------------------------------------

# URL for the workitem-post trigger (plain insert, no raiseOnBehalfOf).
webtrigger_url=https://webtrigger.atlassian-dev.io/api/v1/invoke/ari:cloud:ecosystem::extension/<app-id>/<env-id>/static/workitem-post

# URL for the workitem-as-user-post trigger (insert with raiseOnBehalfOf).
webtrigger_as_user_url=https://webtrigger.atlassian-dev.io/api/v1/invoke/ari:cloud:ecosystem::extension/<app-id>/<env-id>/static/workitem-as-user-post

# URL for the workitem-upsert-post trigger (upsert, no raiseOnBehalfOf).
webtrigger_upsert_url=https://webtrigger.atlassian-dev.io/api/v1/invoke/ari:cloud:ecosystem::extension/<app-id>/<env-id>/static/workitem-upsert-post

# URL for the workitem-upsert-as-user-post trigger (upsert with raiseOnBehalfOf).
webtrigger_upsert_as_user_url=https://webtrigger.atlassian-dev.io/api/v1/invoke/ari:cloud:ecosystem::extension/<app-id>/<env-id>/static/workitem-upsert-as-user-post

# ---------------------------------------------------------------------------
# Required for all workitem endpoints
# ---------------------------------------------------------------------------

# Jira project key (e.g. CS). Token holder must have Create Issue permission here.
project=CS

# Issue type name valid in the project above (e.g. Story, Bug, Task).
issue_type=Story

# ---------------------------------------------------------------------------
# Required for as-user and upsert/as-user endpoints only
# ---------------------------------------------------------------------------

# Jira accountId of the user to raise issues on behalf of.
# You can get this from the Forge admin page's Account ID lookup section.
raise_on_behalf_of=557057:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
