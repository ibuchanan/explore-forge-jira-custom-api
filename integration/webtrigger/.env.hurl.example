# Copy this file to integration/webtrigger/.env.hurl and fill in your values.
# integration/webtrigger/.env.hurl is git-ignored — never commit real secrets.
#
# Used by: npm run test:api:webtrigger
# Hurl variables docs: https://hurl.dev/docs/manual.html#variables
#
# Webtrigger URLs are generated per-installation. After deploying and installing
# the app, retrieve them with:
#
#   forge webtrigger list
#
# Each trigger has its own URL. Use the URL for each trigger key below.

# ---------------------------------------------------------------------------
# JWT bootstrap
# ---------------------------------------------------------------------------

# `npm run test:api:bootstrap:webtrigger` loads WEBTRIGGER_TOKEN and
# WEBTRIGGER_AS_USER_TOKEN from apps/webtrigger/.env, mints short-lived JWTs,
# and writes them to integration/webtrigger/.jwt.hurl. Hurl loads that
# generated file alongside this stable configuration file.
#
# If you need to override the app .env for a one-off bootstrap, this file also
# supports legacy webtrigger_token and webtrigger_as_user_token entries.

# ---------------------------------------------------------------------------
# Webtrigger URLs (from `forge webtrigger list`)
# ---------------------------------------------------------------------------

# URL for the workitem-post trigger (plain insert, no raiseOnBehalfOf).
webtrigger_url=<paste workitem-post URL from forge webtrigger list>

# URL for the workitem-as-user-post trigger (insert with raiseOnBehalfOf).
webtrigger_as_user_url=<paste workitem-as-user-post URL from forge webtrigger list>

# URL for the workitem-upsert-post trigger (upsert, no raiseOnBehalfOf).
webtrigger_upsert_url=<paste workitem-upsert-post URL from forge webtrigger list>

# URL for the workitem-upsert-as-user-post trigger (upsert with raiseOnBehalfOf).
webtrigger_upsert_as_user_url=<paste workitem-upsert-as-user-post URL from forge webtrigger list>

# ---------------------------------------------------------------------------
# Required for all workitem endpoints
# ---------------------------------------------------------------------------

# Jira project key (e.g. MOBL). Token holder must have Create Issue permission here.
project=MOBL

# Issue type name valid in the project above (e.g. Story, Bug, Task).
issue_type=Story

# ---------------------------------------------------------------------------
# Required for as-user and upsert/as-user endpoints only
# ---------------------------------------------------------------------------

# Jira accountId of the user to raise issues on behalf of.
# You can get this from the Forge admin page's Account ID lookup section.
raise_on_behalf_of=557057:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
