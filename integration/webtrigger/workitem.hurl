# Workitem Webtrigger integration tests
#
# This file uses JWTs generated by `npm run test:api:webtrigger:bootstrap`,
# then reuses them for all requests in this Hurl session.
#
# Generate one UUID per Hurl run. Per Hurl's documented `[Options] variable:`
# behavior, variables defined here are available to following requests. The
# upsert happy paths reuse this value in both the issue summary and dedup JQL
# while integration/webtrigger/.env.hurl stays stable.
GET https://example.invalid/bootstrap-variables
[Options]
skip: true
variable: uuid={{newUuid}}
variable: token={{webtrigger_jwt}}
variable: as_user_token={{webtrigger_as_user_jwt}}

HTTP *

# POST workitem-post — outside-in integration tests
#
# Prerequisites:
#   - The app must be deployed and installed on the target site.
#   - forge variables set WEBTRIGGER_TOKEN <secret>
#   - npm run test:api:webtrigger:bootstrap  (mints JWTs into .jwt.hurl)
#
# Run with:
#   npm run test:api:webtrigger
#
# .env.hurl variables (see integration/webtrigger/.env.hurl.example):
#   webtrigger_url      = <URL from `forge webtrigger list` for workitem-post>
#   project             = <Jira project key, e.g. HSP>
#   issue_type          = <issue type name, e.g. Story>


# ---------------------------------------------------------------------------
# Happy path — create a minimal issue
# ---------------------------------------------------------------------------
POST {{webtrigger_url}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": {
    "Summary": "Webtrigger integration test issue [hurl]"
  }
}

HTTP 201
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.id" isString
jsonpath "$.key" matches /^[A-Z]+-\d+$/
jsonpath "$.self" startsWith "https://"


# ---------------------------------------------------------------------------
# Happy path — create an issue with an optional update block
# ---------------------------------------------------------------------------
POST {{webtrigger_url}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": {
    "Summary": "Webtrigger integration test issue with update [hurl]"
  },
  "update": {
    "Labels": [{ "add": "hurl-test" }]
  }
}

HTTP 201
[Asserts]
jsonpath "$.key" matches /^[A-Z]+-\d+$/


# ---------------------------------------------------------------------------
# 400 — missing required field: project
# ---------------------------------------------------------------------------
POST {{webtrigger_url}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "Missing project" }
}

HTTP 400
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.status" == 400
jsonpath "$.detail" isString


# ---------------------------------------------------------------------------
# 400 — missing required field: issueType
# ---------------------------------------------------------------------------
POST {{webtrigger_url}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "fields": { "Summary": "Missing issueType" }
}

HTTP 400
[Asserts]
jsonpath "$.status" == 400
jsonpath "$.detail" isString


# ---------------------------------------------------------------------------
# 400 — missing required field: fields
# ---------------------------------------------------------------------------
POST {{webtrigger_url}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}"
}

HTTP 400
[Asserts]
jsonpath "$.status" == 400
jsonpath "$.detail" isString


# ---------------------------------------------------------------------------
# 400 — malformed JSON body
# ---------------------------------------------------------------------------
POST {{webtrigger_url}}
Authorization: Bearer {{token}}
Content-Type: application/json
```
not valid json at all
```

HTTP 400
[Asserts]
jsonpath "$.status" == 400
jsonpath "$.detail" isString


# ---------------------------------------------------------------------------
# 401 — missing Authorization header
# ---------------------------------------------------------------------------
POST {{webtrigger_url}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "No auth" }
}

HTTP 401
[Asserts]
header "WWW-Authenticate" == "Bearer"
jsonpath "$.status" == 401


# ---------------------------------------------------------------------------
# 401 — invalid JWT (wrong token)
# ---------------------------------------------------------------------------
POST {{webtrigger_url}}
Authorization: Bearer not.a.valid.jwt
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "Bad JWT" }
}

HTTP 401
[Asserts]
header "WWW-Authenticate" == "Bearer"
jsonpath "$.status" == 401


# POST workitem-as-user-post — outside-in integration tests
#
# Tests the raise-on-behalf-of insert endpoint.
# raiseOnBehalfOf is required.
#
# Prerequisites:
#   - forge variables set WEBTRIGGER_AS_USER_TOKEN <secret>
#   - npm run test:api:webtrigger:bootstrap
#
# .env.hurl variables:
#   webtrigger_as_user_url  = <URL from `forge webtrigger list` for workitem-as-user-post>
#   raise_on_behalf_of      = <Jira accountId of the user to raise on behalf of>


# ---------------------------------------------------------------------------
# Happy path — create an issue on behalf of another user
# ---------------------------------------------------------------------------
POST {{webtrigger_as_user_url}}
Authorization: Bearer {{as_user_token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": {
    "Summary": "Webtrigger as-user integration test [hurl]"
  },
  "raiseOnBehalfOf": "{{raise_on_behalf_of}}"
}

HTTP 201
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.id" isString
jsonpath "$.key" matches /^[A-Z]+-\d+$/
jsonpath "$.self" startsWith "https://"


# ---------------------------------------------------------------------------
# 400 — missing required field: raiseOnBehalfOf
# ---------------------------------------------------------------------------
POST {{webtrigger_as_user_url}}
Authorization: Bearer {{as_user_token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "Missing raiseOnBehalfOf" }
}

HTTP 400
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.status" == 400
jsonpath "$.detail" isString
jsonpath "$.detail" contains "raiseOnBehalfOf"


# ---------------------------------------------------------------------------
# 400 — empty raiseOnBehalfOf string
# ---------------------------------------------------------------------------
POST {{webtrigger_as_user_url}}
Authorization: Bearer {{as_user_token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "Empty raiseOnBehalfOf" },
  "raiseOnBehalfOf": ""
}

HTTP 400
[Asserts]
jsonpath "$.status" == 400
jsonpath "$.detail" isString
jsonpath "$.detail" contains "raiseOnBehalfOf"


# ---------------------------------------------------------------------------
# 400 — missing required field: project
# ---------------------------------------------------------------------------
POST {{webtrigger_as_user_url}}
Authorization: Bearer {{as_user_token}}
Content-Type: application/json
{
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "Missing project" },
  "raiseOnBehalfOf": "{{raise_on_behalf_of}}"
}

HTTP 400
[Asserts]
jsonpath "$.status" == 400
jsonpath "$.detail" isString


# ---------------------------------------------------------------------------
# 400 — malformed JSON body
# ---------------------------------------------------------------------------
POST {{webtrigger_as_user_url}}
Authorization: Bearer {{as_user_token}}
Content-Type: application/json
```
not valid json at all
```

HTTP 400
[Asserts]
jsonpath "$.status" == 400
jsonpath "$.detail" isString


# ---------------------------------------------------------------------------
# 401 — missing Authorization header
# ---------------------------------------------------------------------------
POST {{webtrigger_as_user_url}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "No auth" },
  "raiseOnBehalfOf": "{{raise_on_behalf_of}}"
}

HTTP 401
[Asserts]
header "WWW-Authenticate" == "Bearer"
jsonpath "$.status" == 401


# ---------------------------------------------------------------------------
# 401 — plain token used against as-user endpoint (wrong audience)
# ---------------------------------------------------------------------------
POST {{webtrigger_as_user_url}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "Wrong audience" },
  "raiseOnBehalfOf": "{{raise_on_behalf_of}}"
}

HTTP 401
[Asserts]
header "WWW-Authenticate" == "Bearer"
jsonpath "$.status" == 401


# POST workitem-upsert-post — outside-in integration tests
#
# Tests the upsert endpoint (create or return existing, no raiseOnBehalfOf).
# dedup is required.
#
# .env.hurl variables:
#   webtrigger_upsert_url = <URL from `forge webtrigger list` for workitem-upsert-post>


# ---------------------------------------------------------------------------
# Happy path — create a new issue (no dedup match)
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_url}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": {
    "Summary": "Webtrigger upsert integration test [hurl] {{uuid}}"
  },
  "dedup": "project = {{project}} AND summary = \"Webtrigger upsert integration test [hurl] {{uuid}}\""
}

HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.created" == true
jsonpath "$.id" isString
jsonpath "$.key" matches /^[A-Z]+-\d+$/
jsonpath "$.self" startsWith "https://"
jsonpath "$.matches" isCollection
jsonpath "$.matches" isEmpty
jsonpath "$.warnings" isCollection


# ---------------------------------------------------------------------------
# Dedup hit — returns created: false when JQL matches existing issues
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_url}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": {
    "Summary": "Webtrigger upsert dedup hit [hurl]"
  },
  "dedup": "project = {{project}} AND summary ~ \"Webtrigger upsert dedup hit [hurl]\" ORDER BY created DESC"
}

HTTP 200
[Asserts]
jsonpath "$.created" == false
jsonpath "$.id" == null
jsonpath "$.key" == null
jsonpath "$.self" == null
jsonpath "$.matches" isCollection
jsonpath "$.warnings" isCollection


# ---------------------------------------------------------------------------
# 400 — missing required field: dedup
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_url}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "Missing dedup" }
}

HTTP 400
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.status" == 400
jsonpath "$.detail" isString


# ---------------------------------------------------------------------------
# 400 — empty dedup string
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_url}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "Empty dedup" },
  "dedup": "   "
}

HTTP 400
[Asserts]
jsonpath "$.status" == 400
jsonpath "$.detail" isString


# ---------------------------------------------------------------------------
# 400 — missing required field: project
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_url}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "Missing project" },
  "dedup": "project = {{project}}"
}

HTTP 400
[Asserts]
jsonpath "$.status" == 400
jsonpath "$.detail" isString


# ---------------------------------------------------------------------------
# 400 — malformed JSON body
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_url}}
Authorization: Bearer {{token}}
Content-Type: application/json
```
not valid json at all
```

HTTP 400
[Asserts]
jsonpath "$.status" == 400
jsonpath "$.detail" isString


# ---------------------------------------------------------------------------
# 401 — missing Authorization header
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_url}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "No auth" },
  "dedup": "project = {{project}}"
}

HTTP 401
[Asserts]
header "WWW-Authenticate" == "Bearer"
jsonpath "$.status" == 401


# POST workitem-upsert-as-user-post — outside-in integration tests
#
# Tests the raise-on-behalf-of upsert endpoint.
# Both raiseOnBehalfOf and dedup are required.
#
# .env.hurl variables:
#   webtrigger_upsert_as_user_url = <URL for workitem-upsert-as-user-post>
#   raise_on_behalf_of            = <Jira accountId>


# ---------------------------------------------------------------------------
# Happy path — create a new issue on behalf of another user (no dedup match)
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_as_user_url}}
Authorization: Bearer {{as_user_token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": {
    "Summary": "Webtrigger upsert as-user integration test [hurl] {{uuid}}"
  },
  "dedup": "project = {{project}} AND summary = \"Webtrigger upsert as-user integration test [hurl] {{uuid}}\"",
  "raiseOnBehalfOf": "{{raise_on_behalf_of}}"
}

HTTP 200
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.created" == true
jsonpath "$.id" isString
jsonpath "$.key" matches /^[A-Z]+-\d+$/
jsonpath "$.self" startsWith "https://"
jsonpath "$.matches" isCollection
jsonpath "$.matches" isEmpty
jsonpath "$.warnings" isCollection


# ---------------------------------------------------------------------------
# Dedup hit — returns created: false when JQL matches existing issues
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_as_user_url}}
Authorization: Bearer {{as_user_token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": {
    "Summary": "Webtrigger upsert as-user dedup hit [hurl]"
  },
  "dedup": "project = {{project}} AND summary ~ \"Webtrigger upsert as-user dedup hit [hurl]\" ORDER BY created DESC",
  "raiseOnBehalfOf": "{{raise_on_behalf_of}}"
}

HTTP 200
[Asserts]
jsonpath "$.created" == false
jsonpath "$.id" == null
jsonpath "$.key" == null
jsonpath "$.self" == null
jsonpath "$.matches" isCollection
jsonpath "$.warnings" isCollection


# ---------------------------------------------------------------------------
# 400 — missing required field: raiseOnBehalfOf
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_as_user_url}}
Authorization: Bearer {{as_user_token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "Missing raiseOnBehalfOf" },
  "dedup": "project = {{project}}"
}

HTTP 400
[Asserts]
header "Content-Type" contains "application/json"
jsonpath "$.status" == 400
jsonpath "$.detail" isString
jsonpath "$.detail" contains "raiseOnBehalfOf"


# ---------------------------------------------------------------------------
# 400 — missing required field: dedup
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_as_user_url}}
Authorization: Bearer {{as_user_token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "Missing dedup" },
  "raiseOnBehalfOf": "{{raise_on_behalf_of}}"
}

HTTP 400
[Asserts]
jsonpath "$.status" == 400
jsonpath "$.detail" isString


# ---------------------------------------------------------------------------
# 400 — empty dedup string
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_as_user_url}}
Authorization: Bearer {{as_user_token}}
Content-Type: application/json
{
  "project": "{{project}}",
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "Empty dedup" },
  "dedup": "   ",
  "raiseOnBehalfOf": "{{raise_on_behalf_of}}"
}

HTTP 400
[Asserts]
jsonpath "$.status" == 400
jsonpath "$.detail" isString


# ---------------------------------------------------------------------------
# 400 — missing required field: project
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_as_user_url}}
Authorization: Bearer {{as_user_token}}
Content-Type: application/json
{
  "issueType": "{{issue_type}}",
  "fields": { "Summary": "Missing project" },
  "dedup": "project = {{project}}",
  "raiseOnBehalfOf": "{{raise_on_behalf_of}}"
}

HTTP 400
[Asserts]
jsonpath "$.status" == 400
jsonpath "$.detail" isString


# ---------------------------------------------------------------------------
# 400 — malformed JSON body
# ---------------------------------------------------------------------------
POST {{webtrigger_upsert_as_user_url}}
Authorization: Bearer {{as_user_token}}
Content-Type: application/json
