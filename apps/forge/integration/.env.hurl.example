# Copy this file to integration/.env.hurl and fill in your values.
# integration/.env.hurl is git-ignored — never commit real tokens.
#
# Used by: npm run test:api
# Hurl docs: https://hurl.dev/docs/manual.html#variables
#
# URL format:
#   https://<site>.atlassian.net/gateway/api/svc/jira/apps/<app-id>_<env-id>
#
# - app-id:  from manifest.yml app.id (strip the ari:cloud:ecosystem::app/ prefix)
# - env-id:  from `forge environments list` (UUID for the target environment)

# ---------------------------------------------------------------------------
# Required for all endpoints
# ---------------------------------------------------------------------------

# Base URL for this app's Forge App REST API
base_url=https://your-site.atlassian.net/gateway/api/svc/jira/apps/bb398628-d837-4378-9fe5-9b033fb24aac_<env-id>

# 3LO OAuth 2.0 bearer token.
# Required scopes:
#   write:workitem:custom          — for /workitem and /workitem/upsert
#   write:workitem-as-user:custom  — for /workitem/asuser and /workitem/upsert/asuser
token=<your-3lo-bearer-token>

# Jira project key (e.g. HSP). Token holder must have Create Issue permission here.
project=HSP

# Issue type name valid in the project above (e.g. Story, Bug, Task)
issue_type=Story

# ---------------------------------------------------------------------------
# Required for /workitem/asuser and /workitem/upsert/asuser only
# ---------------------------------------------------------------------------

# Jira accountId of the user to raise issues on behalf of.
# Find via: GET https://<site>.atlassian.net/rest/api/3/myself
raise_on_behalf_of=557057:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Required for upsert happy-path tests — must be unique per run to avoid
# dedup collisions. Use a timestamp or UUID.
# ---------------------------------------------------------------------------
uuid=replace-with-unique-value
