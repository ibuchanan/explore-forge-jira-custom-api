# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real values.
#
# Used by the forge:deploy, forge:install, forge:uninstall, and forge:upgrade scripts.

# Your Atlassian site subdomain (without .atlassian.net)
# e.g. if your site is mycompany.atlassian.net, set FORGE_SITENAME=mycompany
FORGE_SITENAME=your-site

# The Atlassian product to install the app on
# Valid values: jira, confluence
FORGE_PRODUCT=jira

# The Forge environment targeted by Forge CLI scripts.
# Common values: development, staging, production
FORGE_ENVIRONMENT=development
