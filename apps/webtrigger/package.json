{
  "name": "jira-custom-api-via-webtriggers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "changelog": "git cliff",
    "check": "npm run test && npm run lint && npm run format:check && npm run typecheck",
    "clean": "rm -rf ./dist",
    "dev": "echo 'Not implemented'",
    "forge:scopes": "source .env && forge custom-scopes create --environment $FORGE_ENVIRONMENT",
    "forge:deploy": "source .env && forge deploy --environment $FORGE_ENVIRONMENT",
    "forge:install": "source .env && forge install --site \"$FORGE_SITENAME.atlassian.net\" --product $FORGE_PRODUCT --environment $FORGE_ENVIRONMENT --non-interactive",
    "forge:uninstall": "source .env && forge uninstall --site \"$FORGE_SITENAME.atlassian.net\" --product $FORGE_PRODUCT",
    "forge:upgrade": "source .env && forge install --upgrade --site \"$FORGE_SITENAME.atlassian.net\" --product $FORGE_PRODUCT --environment $FORGE_ENVIRONMENT --non-interactive",
    "forge:variables:set:dotenv": "./scripts/forge-vars-from-env.sh",
    "forge:webtrigger:list": "source .env && forge webtrigger list --site \"$FORGE_SITENAME.atlassian.net\" --product $FORGE_PRODUCT --environment $FORGE_ENVIRONMENT",
    "format": "biome format --write",
    "format:check": "biome format",
    "generate": "npm run generate:openapi",
    "generate:openapi": "npm run generate:openapi --workspace=forge-ahead",
    "lint": "npm run lint:check && forge lint",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write",
    "prepare": "echo 'Not implemented'",
    "preview": "echo 'Not implemented'",
    "start": "echo 'Not implemented'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "todo": "grep -rn 'TODO' --exclude='package.json' . --color=auto || echo 'No TODOs found!'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forge/api": "^7.1",
    "@forge/resolver": "^1.8.0",
    "forge-ahead": "*",
    "jose": "^6.2.3",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@forge/bridge": "^5.16",
    "@forge/react": "^11.15",
    "@types/node": "*",
    "@types/react": "18",
    "archunit": "*",
    "git-cliff": "*",
    "react": "^18.3",
    "typescript": "5",
    "vitest": "*",
    "yaml": "^2.9"
  }
}
